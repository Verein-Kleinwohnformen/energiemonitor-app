rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ========================================
    // Helper Functions für Device-Zugriffskontrolle
    // ========================================
    
    // Prüft ob User Lesezugriff auf ein Device hat
    function canReadDevice(deviceId) {
      return request.auth != null 
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && deviceId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.monitor_read;
    }
    
    // Prüft ob User Schreibzugriff auf ein Device hat
    function canEditDevice(deviceId) {
      return request.auth != null 
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && deviceId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.monitor_edit;
    }
    
    // ========================================
    // Device-spezifische Manuelle Eingaben
    // ========================================
    
    match /devices/{deviceId}/manual/{year}/data/{entryId} {
      // Nur User mit Zugriff auf das Device dürfen lesen/schreiben
      allow read: if canReadDevice(deviceId);
      allow write: if canEditDevice(deviceId);
    }
    
    // ========================================
    // Metering Point Metadata
    // ========================================
    
    match /devices/{deviceId}/metering_points/{meteringPoint} {
      // Nur User mit Zugriff auf das Device dürfen Metadata lesen
      // Schreiben nur mit Edit-Rechten (falls manuell geändert)
      allow read: if canReadDevice(deviceId);
      allow write: if canEditDevice(deviceId);
    }
    
    // ========================================
    // Telemetrie-Daten (Sensor-Messwerte)
    // ========================================
    
    match /devices/{deviceId}/telemetry/{year}/{month}/{uuid} {
      // Nur User mit Lesezugriff auf das Device dürfen Telemetrie-Daten lesen
      // WICHTIG: Schreiben nur via API (nicht von der App), daher write: false
      allow read: if canReadDevice(deviceId);
      allow write: if false; // Telemetrie wird ausschließlich via energiemonitor-api geschrieben
    }
    
    // ========================================
    // Monitore (Energiemonitor-Geräte)
    // ========================================
    
    match /monitors/{monitorId} {
      // Nur eingeloggte User können Monitore sehen
      // Keine Schreibrechte (werden manuell in Firebase Console verwaltet)
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ========================================
    // User-Dokumente
    // ========================================
    
    match /users/{userId} {
      // Jeder User liest nur sein eigenes Dokument.
      allow read: if request.auth != null && request.auth.uid == userId;

      // Beim Registrieren bekommt jeder User ausschliesslich den Sandbox-Monitor.
      // Zugriff auf echte Monitore vergibt nur das Team (Firebase Console / Admin SDK).
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.monitor_read == ['sandbox_monitor']
        && request.resource.data.monitor_edit == ['sandbox_monitor']
        && request.resource.data.monitor_api_keys == {};

      // Zugriffsrechte und API-Keys darf der User nicht selbst aendern.
      allow update: if request.auth != null
        && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['monitor_read', 'monitor_edit', 'monitor_api_keys']);
    }
  }
}
