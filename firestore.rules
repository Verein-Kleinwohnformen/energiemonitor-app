rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ========================================
    // Helper Functions für Device-Zugriffskontrolle
    // ========================================
    
    // Prüft ob User Lesezugriff auf ein Device hat
    function canReadDevice(deviceId) {
      return request.auth != null 
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && deviceId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.monitor_read;
    }
    
    // Prüft ob User Schreibzugriff auf ein Device hat
    function canEditDevice(deviceId) {
      return request.auth != null 
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && deviceId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.monitor_edit;
    }
    
    // ========================================
    // Device-spezifische Manuelle Eingaben
    // ========================================
    
    match /devices/{deviceId}/manual/{year}/data/{entryId} {
      // Nur User mit Zugriff auf das Device dürfen lesen/schreiben
      allow read: if canReadDevice(deviceId);
      allow write: if canEditDevice(deviceId);
    }
    
    // ========================================
    // Metering Point Metadata
    // ========================================
    
    match /devices/{deviceId}/metering_points/{meteringPoint} {
      // Nur User mit Zugriff auf das Device dürfen Metadata lesen
      // Schreiben nur mit Edit-Rechten (falls manuell geändert)
      allow read: if canReadDevice(deviceId);
      allow write: if canEditDevice(deviceId);
    }
    
    // ========================================
    // Telemetrie-Daten (Sensor-Messwerte)
    // ========================================
    
    match /devices/{deviceId}/telemetry/{year}/{month}/{uuid} {
      // Nur User mit Lesezugriff auf das Device dürfen Telemetrie-Daten lesen
      // WICHTIG: Schreiben nur via API (nicht von der App), daher write: false
      allow read: if canReadDevice(deviceId);
      allow write: if false; // Telemetrie wird ausschließlich via energiemonitor-api geschrieben
    }

    // ========================================
    // Tageswerte (Etappe 2)
    // ========================================

    // Ein Dokument pro Tag in Lokalzeit, gerechnet von der energiemonitor-api
    // (POST /aggregate). Die App liest nur, schreibt nie.
    match /devices/{deviceId}/daily/{day} {
      allow read: if canReadDevice(deviceId);
      allow write: if false;
    }

    // Stand der Verteilung der Brennstoffe, nur fuer das Backend.
    match /devices/{deviceId}/aggregation/{docId} {
      allow read, write: if false;
    }

    // Heizwerte und Primaerenergiefaktoren mit Quelle und Datum. Das Team
    // pflegt sie in der Firebase Console; die App liest nur.
    match /config/factors {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ========================================
    // Monitore (Energiemonitor-Geräte)
    // ========================================

    // Superadmin: Custom Claim im Login-Token. Er wird nur mit dem Admin SDK
    // bzw. der Identity Toolkit API gesetzt (tool/admin/), nie aus der App.
    // Ein Superadmin verwaltet Zugriffe, sieht dadurch aber keine Messdaten:
    // dafuer braucht auch er einen Eintrag in monitor_read.
    function isSuperadmin() {
      return request.auth != null && request.auth.token.superadmin == true;
    }

    match /monitors/{monitorId} {
      // Einen Monitor lesen nur mit Zugriff darauf. Die ganze Liste (Name und
      // Ort aller Haeuser) sieht nur der Superadmin. Keine Schreibrechte aus
      // der App, auch nicht fuer study_mode und study_note: Bewohnende
      // koennen den Studienmodus nicht abschalten.
      allow get: if canReadDevice(monitorId) || isSuperadmin();
      allow list: if isSuperadmin();
      allow write: if false;

      // Haushalt (Personen, Wohnflaeche, Label-Wert) mit Verlauf.
      // Anlegen mit Bearbeitungsrecht, nie aendern oder loeschen: eine
      // Aenderung ist ein neuer Eintrag mit "gueltig ab", damit fuer die
      // Studie nachvollziehbar bleibt, wann sich der Haushalt geaendert hat.
      match /household/{entryId} {
        allow read: if canReadDevice(monitorId);
        allow create: if canEditDevice(monitorId) && validHousehold(request.resource.data);
        allow update, delete: if false;
      }
    }

    function validHousehold(d) {
      return d.keys().hasOnly(['valid_from', 'persons', 'living_area_m2',
                               'label_w_per_person', 'updated_by', 'updated_at'])
        && d.keys().hasAll(['valid_from', 'persons', 'updated_by', 'updated_at'])
        && d.valid_from is string
        && d.valid_from.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.persons is int && d.persons >= 1 && d.persons <= 20
        && (!('living_area_m2' in d) || (d.living_area_m2 is number
              && d.living_area_m2 > 0 && d.living_area_m2 <= 1000))
        && (!('label_w_per_person' in d) || (d.label_w_per_person is number
              && d.label_w_per_person > 0 && d.label_w_per_person <= 10000))
        && d.updated_by == request.auth.uid
        && d.updated_at == request.time;
    }

    // ========================================
    // User-Dokumente und Zugriffe
    // ========================================

    match /users/{userId} {
      // Jede Person liest ihr eigenes Dokument. Der Superadmin liest alle
      // (Liste der Konten mit E-Mail in der Verwaltung).
      allow get: if request.auth != null && (request.auth.uid == userId || isSuperadmin());
      allow list: if isSuperadmin();

      // Beim Registrieren bekommt jede Person ausschliesslich den
      // Sandbox-Monitor. Nur bekannte Felder, keine Rollen oder Rechte.
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['user_id', 'email', 'monitor_read',
             'monitor_edit', 'monitor_api_keys', 'date_created'])
        && request.resource.data.user_id == userId
        && request.resource.data.monitor_read == ['sandbox_monitor']
        && request.resource.data.monitor_edit == ['sandbox_monitor']
        && (!('monitor_api_keys' in request.resource.data)
             || request.resource.data.monitor_api_keys == {})
        && emailFromToken(request.resource.data);

      // Die Person selbst aendert nur diese Felder (Liste der erlaubten
      // Felder, nicht der verbotenen: neue Felder sind damit gesperrt).
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['user_name', 'nickname_changed', 'study_dialog_seen', 'email'])
        && emailFromToken(request.resource.data)
        && (!('study_dialog_seen' in request.resource.data)
             || request.resource.data.study_dialog_seen is list);

      // Der Superadmin aendert nur Lesen und Bearbeiten, und nur zusammen
      // mit einem Protokolleintrag im selben Batch (access_log_id), der genau
      // diese Aenderung beschreibt.
      allow update: if isSuperadmin()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['monitor_read', 'monitor_edit', 'access_log_id',
                       'access_updated_by', 'access_updated_at'])
        && validAccess(request.resource.data)
        && request.resource.data.access_updated_by == request.auth.uid
        && request.resource.data.access_updated_at == request.time
        && accessLogged(userId, resource.data, request.resource.data);

      allow delete: if false;
    }

    // Die E-Mail im User-Dokument ist immer die aus dem Login-Token.
    function emailFromToken(d) {
      return !('email' in d) || d.email == request.auth.token.email;
    }

    // Lesen und Bearbeiten sind Listen von Texten; wer bearbeiten darf, darf
    // auch lesen.
    function validAccess(d) {
      return d.monitor_read is list && d.monitor_edit is list
        && d.monitor_read.size() <= 100
        && d.monitor_edit.toSet().difference(d.monitor_read.toSet()).size() == 0;
    }

    function accessLogged(userId, before, after) {
      let logPath = /databases/$(database)/documents/admin_log/$(after.access_log_id);
      let entry = getAfter(logPath).data;
      return after.access_log_id is string
        && existsAfter(logPath)
        && entry.target_uid == userId
        && entry.actor_uid == request.auth.uid
        && entry.after_read == after.monitor_read
        && entry.after_edit == after.monitor_edit
        && entry.before_read == before.get('monitor_read', [])
        && entry.before_edit == before.get('monitor_edit', []);
    }

    // ========================================
    // Protokoll der Zugriffsaenderungen
    // ========================================

    match /admin_log/{entryId} {
      // Nur der Superadmin legt Eintraege an, immer mit sich selbst als
      // Verfasser und der Serverzeit. Niemand aendert oder loescht sie.
      allow read: if isSuperadmin();
      allow create: if isSuperadmin()
        && request.resource.data.keys().hasOnly(['actor_uid', 'actor_email', 'target_uid',
             'target_email', 'before_read', 'before_edit', 'after_read', 'after_edit', 'at'])
        && request.resource.data.actor_uid == request.auth.uid
        && request.resource.data.at == request.time
        && request.resource.data.after_read is list
        && request.resource.data.after_edit is list;
      allow update, delete: if false;
    }
  }
}
